exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Korrektur" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;fontColor=#777777;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="340"/><mxPoint x="340" y="340"/></Array></mxGeometry></mxCell><mxCell id="v13" value="Reicht der Lagerbestand nicht, entsteht keine Bestellung (siehe BPMN).&lt;br&gt;Den Status ändert nur der Betrieb auf /betrieb/. Graue Übergänge sind Korrekturen nach einem Fehlklick, die der Prototyp erlaubt.&lt;br&gt;Einen Endzustand gibt es nicht: Bestellungen bleiben gespeichert, damit Kunde und Betrieb sie weiter sehen." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="230" y="380" width="960" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>