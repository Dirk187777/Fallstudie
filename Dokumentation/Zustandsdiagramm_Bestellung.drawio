<mxfile host="Mischwerk"><diagram id="d" name="Zustände Bestellung"><mxGraphModel dx="1200" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Mischwerk – Zustände einer Bestellung&lt;/b&gt; (UML-Zustandsdiagramm)" style="text;html=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="v2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="24" height="24" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b style=&quot;font-size:13px&quot;&gt;offen&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;entry / erscheint in der Bestellübersicht des Betriebs" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="230" y="170" width="220" height="100" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b style=&quot;font-size:13px&quot;&gt;in Bearbeitung&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;do / Mischung nach Rezeptur abfüllen" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="220" height="100" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b style=&quot;font-size:13px&quot;&gt;versendet&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;entry / Kunde sieht den Status unter „Mein Konto“" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="970" y="170" width="220" height="100" as="geometry"/></mxCell><mxCell id="e6" value="Kunde bestellt&lt;br&gt;[Bestand ausreichend]&lt;br&gt;/ Bestand abbuchen" style="edgeStyle=orthogonalEdgeS