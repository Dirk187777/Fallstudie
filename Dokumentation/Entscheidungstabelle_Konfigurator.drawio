;align=center;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="536" width="50" height="34" as="geometry"/></mxCell><mxCell id="v129" value="Abgedeckte Fälle (je „–“ verdoppelt)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="70" y="536" width="520" height="34" as="geometry"/></mxCell><mxCell id="v130" value="32" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="590" y="536" width="60" height="34" as="geometry"/></mxCell><mxCell id="v131" value="16" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="650" y="536" width="60" height="34" as="geometry"/></mxCell><mxCell id="v132" value="8" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="710" y="536" width="60" height="34" as="geometry"/></mxCell><mxCell id="v133" value="4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="770" y="536" width="60" height="34" as="geometry"/></mxCell><mxCell id="v134" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="830" y="536" width="60" height="34" as="geometry"/></mxCell><mxCell id="v135" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="890" y="536" width="60" height="34" as="geometry"/></mxCell><mxCell id="v136" value="2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="950" y="536" width="60" height="34" as="geometry"/></mxCell><mxCell id="v137" value="&lt;b&gt;Lesart:&lt;/b&gt; J = ja, N = nein, – = egal, X = Aktion wird ausgeführt.&lt;br&gt;&lt;b&gt;Vollständigkeit:&lt;/b&gt; 32 + 16 + 8 + 4 + 1 + 1 + 2 = 64 = 2&lt;sup&gt;6&lt;/sup&gt; Fälle, jede Kombination ist genau einer Regel zugeordnet.&lt;br&gt;&lt;b&gt;Hinweis Koffein:&lt;/b&gt; Enthält die Mischung Koffein, zeigt der Konfigurator zusätzlich einen Warnhinweis mit der Menge in mg. Das ist keine Ablehnung und deshalb keine Bedingung.&lt;br&gt;&lt;b&gt;Umsetzung:&lt;/b&gt; Die Tabelle zeigt die Prüfung in fester Reihenfolge. Im Prototyp können mehrere Meldungen gleichzeitig erscheinen. Nicht freigegebene Zutaten und Größen bietet der Konfigurator gar nicht erst an, der Server prüft sie trotzdem (B1, B2, B6)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="990" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>